// FlatSharp 7.9.0 schema for NamelessRogue serialization
attribute "fs_serializer";

namespace NamelessRogue.Serialization.Schemas;

table EntityRef (fs_serializer) {
    EntityIndex: ulong;
    ComponentTypeHash: ulong;
}

table SerializedEntity (fs_serializer) {
    EntityIdLow: ulong;
    EntityIdHigh: ulong;
    Components: [EntityRef];
}

table SerializedGame (fs_serializer) {
    SchemaVersion: uint;
    Seed: int;
    Turn: int;
    Entities: [SerializedEntity];
}

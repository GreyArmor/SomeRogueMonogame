<UserControl x:Class="NamelessRogueDataEditor.Views.DialogEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NamelessRogueDataEditor.Views"
             xmlns:vm="clr-namespace:NamelessRogueDataEditor.ViewModels"
             xmlns:editorClasses="clr-namespace:NamelessRogue.Engine.Generation.Editor;assembly=NamelessRogue" 
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MainStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:DialogEditorViewModel/>
    </UserControl.DataContext>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / basic fields -->
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Id:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="180" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Response:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Width="360" Text="{Binding Response, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>

        <!-- Left: TreeView with add/remove buttons -->
        <GroupBox Header="Options" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4" Grid.Row="0">
                    <Button Content="Add Option" Command="{Binding AddOptionCommand}" />
                    <Button Content="Remove Option" Command="{Binding RemoveOptionCommand}" />
                    <Button Content="Add Child" Command="{Binding AddChildOptionCommand}" />
                    <Button Content="Remove Child" Command="{Binding RemoveChildOptionCommand}" />
                </StackPanel>
                <ContentControl x:Name="SelectedItemHelper" Content="{Binding SelectedOptionObject, Mode=OneWayToSource}" Visibility="Collapsed"/>
                <TreeView Grid.Row="1" ItemsSource="{Binding Options}" Name="OptionsTree" Margin="4" SelectedItemChanged="OptionsTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type editorClasses:DialogOption}" ItemsSource="{Binding DialogData.Options}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Id}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding OptionText}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>
        </GroupBox>

        <!-- Right: Details editor for selected option -->
        <GroupBox Header="Selected Option" Grid.Row="1" Grid.Column="1">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Id:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOption.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <TextBlock Text="Option Text:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOption.OptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <TextBlock Text="Outcome Data:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOption.DialogOutcomeData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Vertical">
                    <TextBlock Text="Dialog (child options) Response:" Margin="0,4,0,4"/>
                    <TextBox Text="{Binding SelectedOption.DialogData.Response, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
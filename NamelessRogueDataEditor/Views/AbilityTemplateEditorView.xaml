<UserControl x:Class="NamelessRogueDataEditor.Views.AbilityTemplateEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NamelessRogueDataEditor.ViewModels"
        mc:Ignorable="d"
        Height="Auto" Width="Auto">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MainStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <local:AbilityTemplateEditorViewModel/>
    </UserControl.DataContext>

    <Grid Width="Auto" Height="Auto" >
        <StackPanel>
            <TextBlock Text="Name:"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Description:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Icon Path:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Action Points Cost:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding ActionPointsCost, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Energy Cost:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding EnergyCost, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Target Mode:" Margin="0,8,0,0"/>
            <ComboBox SelectedValue="{Binding TargetMode, Mode=TwoWay}" 
                  ItemsSource="{x:Static local:TargetModeValues.All}" />

            <TextBlock Text="Activation Mode:" Margin="0,8,0,0"/>
            <ComboBox SelectedValue="{Binding ActivationMode, Mode=TwoWay}" 
                  ItemsSource="{x:Static local:ActivationModeValues.All}" />

            <TextBlock Text="Area Of Effect:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding AreaOfEffect, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="Is Active" IsChecked="{Binding Ability.IsActive}" Margin="0,8,0,0"/>

            <TextBlock Text="Range:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Range, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Cooldown Turns:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding CooldownTurns, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Associated Buffs:" Margin="0,8,0,0"/>
            <ListBox ItemsSource="{Binding AssociatedBuffs}" Height="80">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="100" Text="{Binding BuffId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <TextBox Width="200" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Add Buff" Margin="0,2,0,0" 
                Command="{Binding AddBuffCommand}" />

            <TextBlock Text="Ability Actions:" Margin="0,8,0,0"/>
            <ListBox ItemsSource="{Binding AbilityActions}" Height="80" />

            <!--<ComboBox x:Name="AbilityActionPicker" Margin="0,2,0,0"
                  ItemsSource="{x:Static local:AbilityActionValues.All}" />-->

            <!--<Button Content="Add Action" Margin="0,2,0,0"
                Click="" />-->

            <Button Style="{StaticResource DefaultButtonStyle}" Content="Save" IsEnabled="{Binding CanSave}" Command="{Binding SaveCommand}" Margin="0,16,0,0" Height="32"/>

        </StackPanel>
    </Grid>

</UserControl>

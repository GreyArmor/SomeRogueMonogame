<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:nrEnum="clr-namespace:NamelessRogue.Engine.Components.ItemComponents;assembly=NamelessRogue"
                    >
    <Style TargetType="Button" x:Key="DefaultButtonStyle">
            <Setter Property="Width" Value="Auto"></Setter>
            <Setter Property="Height" Value="50"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Minimum" Value="-999"></Setter>
        <Setter Property="Maximum" Value="999"></Setter>
        <Setter Property="AutoToolTipPlacement" Value="TopLeft"></Setter>
    </Style>
</ResourceDictionary>
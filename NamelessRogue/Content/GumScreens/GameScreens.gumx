<?xml version="1.0" encoding="utf-8"?>
<GumProjectSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CustomProperties />
  <FontRanges>32-126,160-255</FontRanges>
  <FontSpacingVertical>1</FontSpacingVertical>
  <FontSpacingHorizontal>1</FontSpacingHorizontal>
  <UseFontCharacterFile>false</UseFontCharacterFile>
  <AutoSizeFontOutputs>false</AutoSizeFontOutputs>
  <FontGenerator>KernSmith</FontGenerator>
  <Version>4</Version>
  <DefaultCanvasWidth>800</DefaultCanvasWidth>
  <DefaultCanvasHeight>600</DefaultCanvasHeight>
  <CustomCanvasSizes>
    <CustomCanvasSize>
      <Width xsi:nil="true" />
      <Height xsi:nil="true" />
      <FriendlyName>Project Default</FriendlyName>
    </CustomCanvasSize>
    <CustomCanvasSize>
      <Width>640</Width>
      <Height>480</Height>
      <FriendlyName>480p</FriendlyName>
    </CustomCanvasSize>
    <CustomCanvasSize>
      <Width>1280</Width>
      <Height>720</Height>
      <FriendlyName>720p</FriendlyName>
    </CustomCanvasSize>
    <CustomCanvasSize>
      <Width>1280</Width>
      <Height>800</Height>
      <FriendlyName>Steam Deck</FriendlyName>
    </CustomCanvasSize>
    <CustomCanvasSize>
      <Width>1920</Width>
      <Height>1080</Height>
      <FriendlyName>1080p</FriendlyName>
    </CustomCanvasSize>
    <CustomCanvasSize>
      <Width>3840</Width>
      <Height>2160</Height>
      <FriendlyName>4k</FriendlyName>
    </CustomCanvasSize>
  </CustomCanvasSizes>
  <ShowOutlines>true</ShowOutlines>
  <ShowCanvasOutline>true</ShowCanvasOutline>
  <ShowRuler>true</ShowRuler>
  <ShowCheckerBackground>true</ShowCheckerBackground>
  <TextureFilter>Point</TextureFilter>
  <ConvertVariablesOnUnitTypeChange>false</ConvertVariablesOnUnitTypeChange>
  <RestrictToUnitValues>true</RestrictToUnitValues>
  <SnapToGrid>false</SnapToGrid>
  <GridSize>16</GridSize>
  <RestrictFileNamesForAndroid>false</RestrictFileNamesForAndroid>
  <Guides />
  <ShowLocalizationInGum>true</ShowLocalizationInGum>
  <CurrentLanguageIndex>0</CurrentLanguageIndex>
  <ScreenReference Name="MainScreen" />
  <ScreenReference Name="Neon/DemoScreenGum" />
  <ComponentReference Name="Neon/Controls/Button" />

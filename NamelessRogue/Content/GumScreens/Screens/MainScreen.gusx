      <Value xsi:type="xsd:float">50</Value>
    </Variable>
    <Variable Type="string" Name="OptionsButton.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">ContainerInstance</Value>
    </Variable>
    <Variable Type="string" Name="OptionsButton.Text" SetsValue="true">
